# Copy to .env and fill in.  NEVER commit .env.

# SQLite file (created automatically). Default: instance/resume_builder.db
# DATABASE_PATH=instance/resume_builder.db

# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false

# ---- AI provider -------------------------------------------------------
# gemini | openai | anthropic | offline   (blank = use the first key found, else offline)
AI_PROVIDER=gemini

# Google Gemini (free tier available: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

AI_TIMEOUT=30
AI_REQUESTS_PER_HOUR=60

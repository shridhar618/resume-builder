# Copy to .env and fill in.  NEVER commit .env.

# ---- Database ----------------------------------------------------------
# Production (Vercel): a hosted Turso / libSQL database. Required on Vercel,
# because serverless functions can't keep a local database file.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# Local development: when TURSO_DATABASE_URL is unset, a SQLite file is used
# (created automatically). Default: instance/resume_builder.db
# DATABASE_PATH=instance/resume_builder.db

# Set to true when served over HTTPS (always true on Vercel)
SESSION_COOKIE_SECURE=false

# ---- AI provider -------------------------------------------------------
# gemini | openai | anthropic | offline   (blank = use the first key found, else offline)
AI_PROVIDER=gemini

# Google Gemini (free tier available: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

AI_TIMEOUT=30
AI_REQUESTS_PER_HOUR=60
